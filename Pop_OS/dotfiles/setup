#!/bin/bash

# set some colors
CNT="[\e[1;36mNOTE\e[0m]"
COK="[\e[1;32mOK\e[0m]"
CER="[\e[1;31mERROR\e[0m]"
CAT="[\e[1;37mATTENTION\e[0m]"
CWR="[\e[1;35mWARNING\e[0m]"
CAC="[\e[1;33mACTION\e[0m]"
INSTLOG="install.log"

#clear the screen
clear

# downloads
cd ~/Downloads

# online deb files to retrieve
wget -O vscode.deb 'https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64'

# install all the deb files retrieved from the internet
sudo apt install -f ./*.deb

# brave Browser
curl -fsS https://dl.brave.com/install.sh | sh

# notify-send
sudo apt install libnotify-bin -y

# grub-install (for creating a windows 11 bootable usb)
sudo apt install grub-pc-bin grub-efi -y

# terminal copy to clipboard tool
sudo apt install xclip -y

# fm6000
curl https://codeberg.org/anhsirk0/fetch-master-6000/raw/branch/main/fm6000.pl --output fm6000
chmod +x fm6000
mkdir -p ~/.local/bin/
cp fm6000 ~/.local/bin/

# flatpak install:
sudo apt install flatpak
sudo add-apt-repository ppa:flatpak/stable
sudo apt update
sudo apt install flatpak

# add flathub repo
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# flathub packages:
flatpak install flathub org.flameshot.Flameshot --user -y
#flatpak install flathub com.brave.Browser --user -y
flatpak install flathub com.discordapp.Discord --user -y
flatpak install flathub com.github.xournalpp.xournalpp --user -y
flatpak install flathub com.obsproject.Studio --user -y
#flatpak install flathub com.unity.UnityHub --user -y
flatpak install flathub org.gimp.GIMP --user -y
flatpak install flathub com.microsoft.Edge --user -y
# github desktop
flatpak install flathub io.github.shiftey.Desktop --user -y
#flatpak install flathub org.mypaint.MyPaint --user -y

# setup symlink to config files
