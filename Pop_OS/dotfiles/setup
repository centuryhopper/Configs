ln -s ~/projects/Configs/Pop_OS/dotfiles/nvim/ ~/.config/
ln -s ~/projects/Configs/Pop_OS/dotfiles/yazi/ ~/.config/
ln -s ~/projects/Configs/Pop_OS/dotfiles/kitty/ ~/.config/
ln -s ~/projects/Configs/Pop_OS/dotfiles/tmux/ ~/.config/
ln -s ~/projects/Configs/Pop_OS/dotfiles/extras/starship.toml ~/.config/
ln -s ~/projects/Configs/Pop_OS/dotfiles/autostart/random_animated_wallpaper ~/.config/autostart/
ln -s ~/projects/Configs/Pop_OS/dotfiles/autostart/autostart-test.desktop ~/.config/autostart/
ln -s ~/projects/Configs/Pop_OS/dotfiles/autostart/code-ws1.desktop ~/.config/autostart/
ln -s ~/projects/Configs/Pop_OS/dotfiles/autostart/code-ws2.desktop ~/.config/autostart/
ln -s ~/projects/Configs/Pop_OS/dotfiles/autostart/connect_to_synology ~/.config/autostart/
ln -s ~/projects/Configs/Pop_OS/dotfiles/autostart/open_file_explorer ~/.config/autostart/
ln -s ~/projects/Configs/Pop_OS/dotfiles/bashrc_extras.sh ~/

# copy the night light command over to home directory so that the user can easily recall the command in another tty when setting night light
cp ~/projects/Configs/Pop_OS/dotfiles/nightlight_command ~/

# use ls -l ~/.config/ to check symlinks
echo "source ~/bashrc_extras.sh" >>~/.bashrc

# more tools
sudo apt install -y ncdu bat cmake htop rpi-imager cheese tree neofetch cmatrix fish xsel nmap git-filter-repo

# iphone transfer Files
sudo apt install ifuse

# 7zip
sudo apt install p7zip-full

# for pop os built in video player
sudo apt install -y gstreamer1.0-libav ffmpeg

# postgresql
#sudo apt install -y postgresql

