#!/bin/bash

sudo apt install openssh-server -yes
sudo systemctl enable --now ssh

# may not need to do this again if already done for github
ssh-keygen -t ed25519            # press Enter through the prompts

# get pc ip by going to pc terminal and executing: Hostname -I
ssh-copy-id leo_zhang@<pc-ip>    # or <hostname>.local

# ssh leo_zhang@<pc-ip> 'fish -c "my_function arg1 arg2"'
# example: ssh leo_zhang@192.168.1.176 'fish -c "notify-email hello from the pi"'

# set up git ssh
# generate ssh key:
ssh-keygen -t ed25519 -C leotheasianlion@gmail.com
# to check ssh agent:
eval "$(ssh-agent -s)"
printf "Host *\n AddKeysToAgent yes\n IdentityFile ~/.ssh/id_ed25519" >~/.ssh/config
ssh-add ~/.ssh/id_ed25519
#add contents of "cat ~/.ssh/id_ed25519.pub" to github ssh key
run "ssh -T git@github.com"

# docker and docker-compose set up
