# Docker (official script, includes docker compose)
curl -fsSL https://get.docker.com | sh
sudo usermod -aG docker $USER
# log out and back in so you can run docker without sudo

# Tailscale
curl -fsSL https://tailscale.com/install.sh | sh
sudo tailscale up # opens a login link

# projects setup
mkdir ~/projects
cd ~/projects
git clone git@github.com:centuryhopper/Tools.git ~/projects/

# case insensitive tab completion
echo "bind -s 'set completion-ignore-case on'" >>~/.bashrc

